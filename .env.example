# GEMINI_API_KEY: Required for optional OCR screenshot extraction.
# AI Studio injects this automatically; on Vercel, add it in Project Settings > Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# MIRROR_SECRET: Optional secret string used to seal Buyer OTP Links and encrypted session cookies on Vercel.
# Recommended when deploying to Vercel: set any random 32+ character string in Vercel Environment Variables.
MIRROR_SECRET=""

# Optional Upstash / Vercel KV REST credentials for persistent multi-instance storage on Vercel.
# (The app also works on Vercel without these using sealed tokens and encrypted cookies.)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
